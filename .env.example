# Environment variables for the HTTP transport in bearer-passthrough mode
# (MCP_AUTH_MODE=bearer-passthrough). Copy to .env or set them in the task
# definition / secret store. NEVER commit real values.

MCP_AUTH_MODE=bearer-passthrough

# nev-api (used for GET /auth/me verification and tenant-scoped calls) and nev-data-api.
NEVENT_API_URL=https://api.nevent.es
NEVENT_DATA_API_URL=https://data.nevent.es

# REQUIRED. Pre-shared secret the client (nev-helpbot) sends on every request in the
# `X-Nevent-Service-Key` header. At least 32 characters; the server refuses to start
# without it. Generate with: openssl rand -hex 32
MCP_BEARER_PASSTHROUGH_SERVICE_KEY=

# OPTIONAL. Previous key, accepted only while rotating (deploy new key as CURRENT and the
# old one here, move the client to the new key, then remove this variable).
MCP_BEARER_PASSTHROUGH_SERVICE_KEY_PREVIOUS=

# OPTIONAL. Write policy. `off` (default, also when unset): every session is READ-only (46 tools).
# `human`: sessions of a person (principalType HUMAN) also get 12 write tools (segments,
# templates, campaigns, short URLs); service sessions (SERVICE) NEVER do. upload_image,
# delete_image and the tenant tools are never exposed. The process REFUSES to start with
# `human` until the write grant (NEV-1855) exists. Calls also need NEVENT_OPERATION_MODE=STANDARD (or FULL, which
# nevent_schedule_campaign requires); startup refuses `human` with READ_ONLY.
# MCP_BEARER_PASSTHROUGH_WRITES=off
# Max write calls per user+tenant per hour when MCP_BEARER_PASSTHROUGH_WRITES=human (default 30).
# Over the limit a write returns a `write_rate_limit_exceeded` tool error; READ is never limited.
# Per process: each instance keeps its own budget; a restart resets it. Max 1000.
# MCP_BEARER_PASSTHROUGH_WRITES_PER_HOUR=30
# Non-production testing only; lets `human` start without a write grant (exactly `true`;
# rejected when NODE_ENV=production; logged at error level on every HUMAN session):
# MCP_BEARER_PASSTHROUGH_WRITES_UNSAFE_NO_GRANT=true

# OPTIONAL. Enables the Mongo-backed READ tools (campaigns, templates, deliverability).
# MONGODB_URI=

# OPTIONAL. Leave UNSET: the caller is a server (nev-helpbot), so CORS stays off and no
# Access-Control-Allow-Origin header is emitted. Set a short comma-separated allowlist only
# if a browser client is ever added. A literal `*` is ignored.
# MCP_ALLOWED_ORIGINS=
