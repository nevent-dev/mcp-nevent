{
  "name": "mcp-nevent",
  "version": "1.0.0",
  "description": "Nevent MCP Server — Analytics + Segmentation tools for nev-data-api",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-nevent": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport=http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --transport=http",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "nevent",
    "analytics",
    "segmentation",
    "bigquery"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/ui": "^2.1.8",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.8"
  }
}
