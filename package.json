{
  "name": "mcp-nevent",
  "mcpName": "io.github.nevent-dev/mcp-nevent",
  "version": "1.8.0",
  "description": "Official Nevent MCP server. Talk to your live-events CRM (campaigns, analytics, paid ads, segments, short URLs, media library) in Claude and ChatGPT. 55 tools across 10 categories with OAuth 2.1 and stdio transports.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-nevent": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Nevent <support@nevent.ai>",
  "license": "MIT",
  "homepage": "https://nevent.ai/en/features/nevent-ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nevent-dev/mcp-nevent.git"
  },
  "bugs": {
    "url": "https://github.com/nevent-dev/mcp-nevent/issues",
    "email": "support@nevent.ai"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anthropic",
    "claude",
    "chatgpt",
    "nevent",
    "events",
    "crm",
    "marketing",
    "analytics",
    "segmentation",
    "paid-ads",
    "meta-ads",
    "google-ads",
    "tiktok-ads",
    "campaigns",
    "deliverability",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport=http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --transport=http",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/jsonwebtoken": "^9.0.10",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@vitest/ui": "^4.1.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.6.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
