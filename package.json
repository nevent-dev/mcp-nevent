{
  "name": "mcp-nevent",
  "version": "1.0.0",
  "description": "Nevent MCP Server — Analytics + Segmentation tools for nev-data-api",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-nevent": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "nevent",
    "analytics",
    "segmentation",
    "bigquery"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/ui": "^2.1.8",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.8"
  }
}
